[Unit]
Description=Omarchy Voice
Documentation=https://github.com/samyn92/omarchy-voice
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/omarchy-voice daemon
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
